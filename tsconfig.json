{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@earendil-works/pi-coding-agent": ["./types/pi-coding-agent.d.ts"]
    },
    "noEmit": true,
    "rootDir": "extensions",
    "outDir": "dist"
  },
  "include": ["extensions/**/*.ts"],
  "exclude": ["node_modules", "dist", "skills", "references"]
}
